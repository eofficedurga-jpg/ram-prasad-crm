# Local development uses embedded Postgres (PGlite) persisted to .data/pgdata.
# Leave DATABASE_URL unset for that behavior, or set it explicitly:
# DATABASE_URL=pglite://./.data/pgdata

# Production (Supabase / Neon / any Postgres). Examples:
# DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_URL=postgres://[user]:[password]@[project]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ram_prasad

# Signing key for session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string-in-production
